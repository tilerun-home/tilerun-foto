TILERUN_FOTO_VERSION=v3.1.0-tilerun.1
TILERUN_FOTO_IMAGE=ghcr.io/tilerun-home/tilerun-foto-server:v3.1.0-tilerun.1
IMMICH_VERSION=v3.1.0
UPLOAD_LOCATION=/volume1/tilerun-data/photos/library
DB_DATA_LOCATION=/volume1/docker/projects/test-webapp/immich/postgres
MODEL_CACHE_LOCATION=/volume1/docker/projects/test-webapp/immich/model-cache
BACKUP_LOCATION=/volume1/docker/projects/test-webapp/immich/backups
TZ=Europe/Paris
DB_USERNAME=immich
DB_DATABASE_NAME=immich
DB_STORAGE_TYPE=HDD
TILERUN_FOTO_EXTERNAL_URL=https://foto.tilerun.net
TILERUN_FOTO_OAUTH_ENABLED=true
TILERUN_FOTO_OIDC_ISSUER=https://CHANGE-ME.cloudflareaccess.com/cdn-cgi/access/sso/oidc/CHANGE-ME
TILERUN_FOTO_OIDC_CLIENT_ID=CHANGE-ME
TILERUN_FOTO_PASSWORD_LOGIN=true
TILERUN_FOTO_REQUIRE_PUBLIC_EDGE=true
TILERUN_FOTO_SUPERUSER_EMAIL=CHANGE-ME@example.com
TILERUN_FOTO_SUPERUSER_NAME=TileRun-beheerder
